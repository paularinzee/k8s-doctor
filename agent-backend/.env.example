OPENAI_API_KEY=sk-...
# Optional: only for a proxy or OpenAI-compatible gateway
# OPENAI_BASE_URL=

DIAGNOSTICS_MODEL_ID=gpt-5.4-mini
REMEDIATION_MODEL_ID=gpt-5.4-mini

# USD per 1K tokens (= per-1M price / 1000)
DIAGNOSTICS_MODEL_PRICE_INPUT_PER_1K=0.00075
DIAGNOSTICS_MODEL_PRICE_OUTPUT_PER_1K=0.0045
REMEDIATION_MODEL_PRICE_INPUT_PER_1K=0.00075
REMEDIATION_MODEL_PRICE_OUTPUT_PER_1K=0.0045